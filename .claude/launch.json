{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "constantin-world",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 8080
    },
    {
      "name": "sanctuaire",
      "cwd": "sanctuaire",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "tunmer-plan",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "../tunmer/serve.js"
      ],
      "port": 4173
    },
    {
      "name": "mountains",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "mountains-serve.js"
      ],
      "port": 4174
    },
    {
      "name": "enable-analogue",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "../enable-analogue",
        "run",
        "dev",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "enable-deck",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "enable-deck-serve.js"
      ],
      "port": 4175
    },
    {
      "name": "studio",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "../constantin.studio.site",
        "run",
        "dev",
        "--",
        "--port=8090"
      ],
      "port": 8090
    },
    {
      "name": "enable-case-study-2",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "enable-cs2-serve.js"
      ],
      "port": 4176
    }
  ]
}
